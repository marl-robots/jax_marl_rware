{
  "size": "small",
  "n_agents": 4,
  "difficulty": "normal",
  "time_limit": 500,
  "parallel_envs": 8,
  "lr": 0.0003,
  "adam_eps": 1e-08,
  "grad_norm_clip": 10.0,
  "gamma": 0.99,
  "double_q": true,
  "standardise_rewards": true,
  "standardise_returns": false,
  "buffer_size": 1000,
  "batch_size": 32,
  "target_update_interval": 200,
  "epsilon_start": 1.0,
  "epsilon_finish": 0.05,
  "epsilon_anneal_time": 200000,
  "evaluation_epsilon": 0.0,
  "hidden_dim": 128,
  "use_rnn": false,
  "mixer": "none",
  "mixing_embed_dim": 32,
  "hypernet_layers": 2,
  "hypernet_embed": 64,
  "parameter_sharing": true,
  "obs_agent_id": true,
  "use_action_mask": false,
  "use_emax": true,
  "ensemble_size": 5,
  "ucb_beta": 1.0,
  "bootstrap_mask_prob": 0.5,
  "bptt_window": 0,
  "t_max": 10000000,
  "seed": 1
}